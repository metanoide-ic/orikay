{
    "name": "Origem - Publicar no Instagram",
    "flow": [
        {
            "id": 1,
            "module": "gateway:CustomWebHook",
            "version": 1,
            "parameters": {
                "hook": 0,
                "maxResults": 1
            },
            "mapper": {},
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 0
                },
                "restore": {
                    "parameters": {
                        "hook": {
                            "label": "Webhook de publicacao da Plataforma Origem"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "hook",
                        "type": "hook:gateway-webhook",
                        "label": "Webhook",
                        "required": true
                    }
                ],
                "interface": [
                    { "name": "tipo", "type": "text" },
                    { "name": "destino", "type": "text" },
                    { "name": "postId", "type": "text" },
                    { "name": "plataforma", "type": "text" },
                    { "name": "cliente", "type": "text" },
                    { "name": "legenda", "type": "text" },
                    { "name": "mediaUrl", "type": "text" }
                ]
            }
        },
        {
            "id": 2,
            "module": "http:ActionSendData",
            "version": 3,
            "parameters": {
                "handleErrors": true,
                "useNewZLibDeCompress": true
            },
            "mapper": {
                "url": "https://graph.facebook.com/v21.0/SEU_IG_USER_ID/media",
                "method": "post",
                "headers": [],
                "qs": [
                    { "name": "access_token", "value": "SEU_TOKEN_DE_ACESSO" },
                    { "name": "image_url", "value": "{{1.mediaUrl}}" },
                    { "name": "caption", "value": "{{1.legenda}}" },
                    { "name": "media_type", "value": "{{if(1.destino = \"story\"; \"STORIES\"; emptystring)}}" }
                ],
                "bodyType": "raw",
                "contentType": "application/json",
                "data": "",
                "gzip": true,
                "useMtls": false,
                "authPass": "",
                "authUser": "",
                "timeout": "",
                "shareCookies": false,
                "parseResponse": true,
                "followRedirect": true,
                "useQuerystring": false,
                "followAllRedirects": false,
                "rejectUnauthorized": true
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0
                },
                "restore": {},
                "expect": [
                    { "name": "url", "type": "url", "label": "URL", "required": true },
                    { "name": "method", "type": "select", "label": "Method", "required": true },
                    { "name": "qs", "type": "array", "label": "Query String" },
                    { "name": "parseResponse", "type": "boolean", "label": "Parse response", "required": true }
                ]
            }
        },
        {
            "id": 3,
            "module": "http:ActionSendData",
            "version": 3,
            "parameters": {
                "handleErrors": true,
                "useNewZLibDeCompress": true
            },
            "mapper": {
                "url": "https://graph.facebook.com/v21.0/SEU_IG_USER_ID/media_publish",
                "method": "post",
                "headers": [],
                "qs": [
                    { "name": "access_token", "value": "SEU_TOKEN_DE_ACESSO" },
                    { "name": "creation_id", "value": "{{2.data.id}}" }
                ],
                "bodyType": "raw",
                "contentType": "application/json",
                "data": "",
                "gzip": true,
                "useMtls": false,
                "authPass": "",
                "authUser": "",
                "timeout": "",
                "shareCookies": false,
                "parseResponse": true,
                "followRedirect": true,
                "useQuerystring": false,
                "followAllRedirects": false,
                "rejectUnauthorized": true
            },
            "metadata": {
                "designer": {
                    "x": 600,
                    "y": 0
                },
                "restore": {},
                "expect": [
                    { "name": "url", "type": "url", "label": "URL", "required": true },
                    { "name": "method", "type": "select", "label": "Method", "required": true },
                    { "name": "qs", "type": "array", "label": "Query String" },
                    { "name": "parseResponse", "type": "boolean", "label": "Parse response", "required": true }
                ]
            }
        }
    ],
    "metadata": {
        "instant": true,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "autoCommitTriggerLast": true,
            "sequential": false,
            "slots": null,
            "confidential": false,
            "dataloss": false,
            "dlq": false,
            "freshVariables": false
        },
        "designer": {
            "orphans": []
        },
        "zone": "us1.make.com",
        "notes": []
    }
}
